+var forcedToolChoiceUnsupportedPatterns = []*regexp.Regexp{
+	regexp.MustCompile(`(?i)only\s+["']?\bauto\b["']?\s+(?:is\s+)?supported\s+for\s+["']?tool[_ ]choice["']?`),
