import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const parameters = __NO_MISTAKES_SCHEMA__;

export default function (pi: ExtensionAPI) {
	pi.registerTool({
		name: "no_mistakes_output",
		label: "Final output",
		description: "Submit the final result matching the requested schema. Call this as your final and only remaining tool call, instead of writing a final assistant response.",
		exposure: "model-only",
		parameters,
		constrainedSampling: { type: "json_schema", strict: "require" },
		async execute(_id, output) {
			return {
				content: [{ type: "text", text: JSON.stringify(output) }],
				details: { output },
				terminate: true,
			};
		},
	});

	pi.on("before_agent_start", () => {
		// --no-tools and explicit allowlists must still permit submitting the
		// result; this tool cannot execute external operations or modify files.
		pi.setActiveTools([...new Set([...pi.getActiveTools(), "no_mistakes_output"])]);
	});
}
